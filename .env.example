# Slack API credentials
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_APP_TOKEN=xapp-your-token

# LLM API credentials
OPENAI_API_KEY=sk-your-openai-key
# or use GROQ_API_KEY or ANTHROPIC_API_KEY

# LLM configuration
LLM_MODEL=gpt-4o-mini

# Google Workspace credentials
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token 
GOOGLE_WORKSPACE_SERVER_PATH=your-workspace-server-path

# openai vector store server
OPENAI_VECTOR_STORE_ID=vs_xxxx
SERVER_TOOL_NAME=server_tool_name
SERVER_TOOL_DESCRIPTION=server_tool_description
OPENAI_VECTOR_STORE_PATH=/xxx/path/to/openai-vector-store-mcp-server/build/index.js

# Python path
PYTHON_PATH=your-python-path